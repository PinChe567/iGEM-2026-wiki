--- css/wetlab-workflow.css (before)
+++ css/wetlab-workflow.css (after)
@@ -1,13 +1,13 @@
 /* Six-stage evidence navigation, scoped to the two wet-lab research pages. */
 .page-results .gel-figure{padding:0;overflow:visible}
-.page-results .gel-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;background:#fff;padding:.6rem;align-items:start}
+.page-results .gel-panels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;background:#fff;padding:.6rem;align-items:start}
 .page-results .gel-panels .gel-panel{display:block;min-width:0;border:0;text-decoration:none;background:#fff;cursor:zoom-in}
-.page-results .gel-panels .gel-panel--c{grid-column:1/-1;width:calc((100% - 1rem)/2);justify-self:center}
+.page-results .gel-panels .gel-panel--c{width:100%}
 .page-results .gel-panels .gel-panel--d{grid-column:1/-1}
 .page-results .gel-panels img{display:block;width:100%;height:auto;max-height:none;object-fit:contain;margin:0;border:0;border-radius:0;box-shadow:none;filter:none}
 .page-results .gel-panels a:focus-visible{outline:3px solid var(--v-accent,#695096);outline-offset:4px}
 .page-results .gel-figure figcaption{padding:.9rem 1rem}
-@media(max-width:700px){.page-results .gel-panels{grid-template-columns:1fr;gap:1.25rem}.page-results .gel-panels .gel-panel--c{width:100%}}
+@media(max-width:760px){.page-results .gel-panels{grid-template-columns:1fr;gap:1.25rem}.page-results .gel-panels .gel-panel--c{width:100%}}
 :is(.page-results,.page-experiments) .wetlab-stage-kicker{margin:0 0 .65rem;color:#087987;font:600 .78rem/1.5 var(--font-mono,monospace);letter-spacing:.06em;text-transform:uppercase}
 :is(.page-results,.page-experiments) .wetlab-stage-status{padding:.75rem 0;margin:.8rem 0 1.2rem;border-top:1px solid #bcd6d7;border-bottom:1px solid #bcd6d7;font-size:.94rem;line-height:1.65}
 :is(.page-results,.page-experiments) .wetlab-progress{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));list-style:none;padding:0;margin:1.3rem 0 1.6rem;gap:0 1.7rem;counter-reset:none;max-width:none}
