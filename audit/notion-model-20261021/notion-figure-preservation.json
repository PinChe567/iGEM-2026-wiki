    {
      "page": "model",
      "label": "model-fly-anatomy",
      "source_block_id": "40025656-1ff8-816b-ade1-c5a3a876eb9d",
      "caption": "The olfactory system of the fruit fly Drosophila melanogaster. Olfactory sensory neurons (OSNs) in the antenna each express one type of olfactory receptor and send their signals to the antennal lobe (AL). Projection neurons (PNs) carry the signal from the AL to the mushroom body (MB), where odors are learned, and to the lateral horn (LH), which drives innate responses. Our model follows the path antenna → AL → PNs → MB: sensor or receptor responses play the role of the OSNs, and the mushroom body is modeled as Kenyon cells read out by output neurons (MBONs). The lateral horn is not modeled.",
      "sha256": "92e5ae4e4097cfe91cfbd78420ab8476c0a8d221c4a26a58b763e25c7bc9bc92",
      "bytes": 115134,
      "actual_format": "WEBP",
      "extension": ".webp",
      "dimensions": [
        906,
        673
      ],
      "content_type": "image/webp",
      "acquisition": "anonymous GET of observed public image URL",
      "http_status": 200,
      "source_url": "https://jealous-ragdoll-815.notion.site/image/attachment%3Af6c0b2cb-41ef-4fba-b466-c53841562a40%3ArId20.png?table=block&id=40025656-1ff8-816b-ade1-c5a3a876eb9d&spaceId=858da421-f8c5-47f5-bb6a-fded4f9f7a8f&width=1370&userId=&cache=v2&imgBuildSrc=requestProxiedImageUrl",
