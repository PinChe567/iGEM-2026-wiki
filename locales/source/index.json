    "tag": "p"
  },
  "7635ef9abdb0": {
    "text": "Reference deviation",
    "tag": "p"
  },
  "e09114ff6d65": {
    "text": "Fungal-associated",
    "tag": "p"
  },
  "284875faa4fc": {
    "text": "odor pattern shift",
    "tag": "p"
  },
  "e92ae88fe09f": {
    "text": "Follow-up recommended",
    "tag": "span"
  },
  "2882bbcf23bd": {
    "text": "Ripening profile changing",
    "tag": "p"
  },
  "9b9717d2debd": {
    "text": "Aroma profile shift",
    "tag": "p"
  },
  "f760fb62e18e": {
    "text": "Everything looks fine.",
    "tag": "p"
  },
  "ea707e49e0b9": {
    "text": "Something has already changed.",
    "tag": "p"
  },
  "656edc088879": {
    "text": "Grain in storage.",
    "tag": "p"
  },
  "3d4470c69f03": {
    "text": "Fruit on the shelf.",
    "tag": "p"
  },
  "c41d29687c0e": {
    "text": "Coffee waiting to be brewed.",
    "tag": "p"
  },
  "a4c85a4b4f5c": {
    "text": "Or does it?",
    "tag": "p"
  },
  "92878adab113": {
    "text": "Nothing looks wrong.",
    "tag": "p"
  },
  "a4e286e9eedc": {
    "text": "But chemistry doesn’t wait for us to notice.",
    "tag": "p"
  },
  "b199cabaaa62": {
    "text": "Food can begin changing",
    "tag": "p"
  },
  "27dc28327069": {
    "text": "before the warning becomes visible.",
    "tag": "p"
  },
  "4e40ed1bf746": {
    "text": "We can’t see this.",
    "tag": "p"
  },
  "ac406ac55a2a": {
    "text": "But a receptor can sense it.",
    "tag": "p"
  },
  "0ae4e1550f70": {
    "text": "We borrowed part of a fruit fly’s sense of smell.",
    "tag": "p"
  },
  "a4d7fd922afd": {
    "text": "OR + Orco sense an odor cue.",
    "tag": "p"
  },
  "ac272572f1c1": {
    "text": "Ca²⁺ rises.",
    "tag": "p"
  },
  "020c6fefbee4": {
    "text": "GCaMP glows.",
    "tag": "p"
  },
  "b81b99eda028": {
    "text": "Faintly, at first.",
    "tag": "p"
  },
  "fdca5ef5dc71": {
    "text": "A glow is not yet a measurement.",
    "tag": "p"
  },
  "a0968adfdc36": {
    "text": "So we designed a reader",
    "tag": "p"
  },
  "9a203409c99f": {
    "text": "for signals almost hidden in noise.",
    "tag": "p"
  },
  "3b1fad2098dc": {
    "text": "One odor.",
    "tag": "p"
  },
  "f3cf227daf60": {
    "text": "Many receptors.",
    "tag": "p"
  },
  "9ea26c5b24b1": {
    "text": "The pattern tells the story.",
    "tag": "p"
  },
  "575e74bcfa8c": {
    "text": "Still looks fine.",
    "tag": "p"
  },
  "0f11409ddf11": {
    "text": "Inspect sooner.",
    "tag": "p"
  },
  "36f8043a68da": {
    "text": "Visual inspection finds nothing obvious.",
    "tag": "p"
  },
  "65fa84d09ba3": {
    "text": "The odor pattern has already begun to shift.",
    "tag": "p"
  },
  "6e090a3473ea": {
    "text": "Sense what sight misses.",
    "tag": "p"
  },
  "fbe226b8adb6": {
    "text": "biological change.",
    "tag": "li"
  },
  "5380b755a067": {
    "text": "weak fluorescence.",
    "tag": "li"
  },
  "01abfdc8f790": {
    "text": "odor patterns.",
    "tag": "li"
  },
  "110b7d4bd91f": {
    "text": "before losses escalate.",
    "tag": "li"
  },
  "5e798af450be": {
    "text": "AeroSense · NTHU iGEM 2026",
    "tag": "p"
  },
  "d1e96ff90f92": {
    "text": "Open reader →",
    "tag": "span"
  },
