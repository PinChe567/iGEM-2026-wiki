    "headingWeight": {
      "$type": "fontWeight",
      "$value": 600
    },
    "heroScale": {
      "$type": "string",
      "$value": "clamp(2.8rem, 5.3vw, 5.4rem)"
    },
    "h2Scale": {
      "$type": "string",
      "$value": "clamp(28px, 3vw, 42px)"
    },
    "h3Scale": {
      "$type": "string",
      "$value": "clamp(20px, 2vw, 24px)"
