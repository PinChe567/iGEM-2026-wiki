{
  "format": "Signal Atlas token dictionary v1; named $type/$value entries for handoff, not a claim of formal DTCG schema validation.",
  "$description": "Signal Atlas illustrated-card restoration, 11 October 2026. Meaningful illustrated dark covers, framed and gently tinted chapter cards, white evidence interiors. Replaces the rejected flat-white draft. Production source: styles/tokens.css.",
  "color": {
    "$type": "color",
    "paper": {
      "$value": "#ffffff",
      "$description": "Primary page canvas and unmodified evidence figure backing."
    },
    "surface": {
      "$value": "#f5f7f6",
      "$description": "Secondary neutral surface."
    },
    "ink": {
      "$value": "#162d29",
      "$description": "Headings and body text across every discipline."
    },
    "muted": {
      "$value": "#52645f",
      "$description": "Captions and secondary text; not opacity-reduced body ink."
    },
    "rule": {
      "$value": "#dce5e0",
      "$description": "Nonessential separators; not the only visible focus or selection cue."
    },
    "bio": {
      "$value": "#247458",
      "$description": "Project identity, Description and Contribution. Wet Lab has a separate turquoise family."
    },
    "instrument": {
      "$value": "#215a89",
      "$description": "Hardware and Measurement accents."
    },
    "model": {
      "$value": "#694698",
      "$description": "Computational model accents."
    },
    "people": {
      "$value": "#9b3268",
      "$description": "Distinct berry-pink for HP, Education, Sustainability, Entrepreneurship and Learning."
    },
    "team": {
      "$value": "#795614",
      "$description": "Amber-gold for Members and Attributions; deliberately separated from Wet Lab turquoise and HP berry-pink."
    },
    "wetLab": {
      "$value": "#087987",
      "$description": "Wet Lab and Alternative Platform, distinct from the project green."
    }
  },
